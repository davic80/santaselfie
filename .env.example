# Hostname que sirve Caddy (y que imprime deploy.sh)
SANTASELFIE_HOST=barba.ojoalprecio.com

# Red Docker externa en la que ya vive el Caddy compartido
# (docker inspect <caddy> --format '{{json .NetworkSettings.Networks}}')
PROXY_NETWORK=cloud_default

# Fijar una versión concreta de la imagen (por defecto: latest)
# SANTASELFIE_TAG=v1.0.0
